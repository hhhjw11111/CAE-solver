&case_control
  schema_version = 2
  case_id = 'G13_H02_R120_L2'
  model_level = 'M2_THERMO_TWO_CARRIER'
  mesh_file = 'mesh.dat'
/

&problem_control
  problem_type = 'CENTER_HOLE_PLATE'
  material_profile = 'TPS_G08_REFERENCE'
  target_voltage = -5.0
  target_voltage_factor = 1.0
  target_joule_factor = 1.0
  hole_radius = 1.2e-7
/

&solver_control
  field_scales = 1.0e-10, 1.0e-10, 1.0e-10, 1.0e1, 1.0e-1, 1.0e-1, 1.0e1
  max_newton = 40
  residual_tolerance = 1.0e-9
  update_tolerance = 1.0e-9
  armijo_c1 = 1.0e-4
  backtrack_factor = 0.5
  minimum_step = 1.0e-8
  maximum_log_density_update = 1.0
  continuation_initial_step = 0.25
  continuation_minimum_step = 0.03125
  continuation_maximum_step = 0.5
  continuation_cutback_factor = 0.5
  continuation_growth_factor = 2.0
  continuation_maximum_attempts = 100
  continuation_maximum_newton_per_attempt = 20
  continuation_fast_iterations = 4
  continuation_slow_iterations = 10
/
