&case_control
  schema_version = 2
  case_id = 'G08_REFERENCE_BAR_PRODUCTION'
  model_level = 'M2_THERMO_TWO_CARRIER'
  mesh_file = 'mesh.dat'
/

&problem_control
  problem_type = 'REFERENCE_BAR'
  material_profile = 'TPS_G08_REFERENCE'
  target_voltage = -1.0000000000000000e1
  target_voltage_factor = 1.0000000000000000e0
  target_joule_factor = 1.0000000000000000e0
/

&solver_control
  field_scales = 1.0e-10, 1.0e-10, 1.0e-10, 1.0e1, 1.0e-1, 1.0e-1, 1.0e1
  max_newton = 40
  residual_tolerance = 1.0e-9
  update_tolerance = 1.0e-9
  armijo_c1 = 1.0e-4
  backtrack_factor = 5.0e-1
  minimum_step = 1.0e-8
  maximum_log_density_update = 1.0e0
  continuation_initial_step = 2.5e-1
  continuation_minimum_step = 3.125e-2
  continuation_maximum_step = 5.0e-1
  continuation_cutback_factor = 5.0e-1
  continuation_growth_factor = 2.0e0
  continuation_maximum_attempts = 100
  continuation_maximum_newton_per_attempt = 20
  continuation_fast_iterations = 4
  continuation_slow_iterations = 10
/
