&case_control
 schema_version=2, case_id='F2_H1_NT_L0_V070', model_level='M2_THERMO_TWO_CARRIER',
 mesh_file='H1_L0.mesh'
/
&problem_control
 problem_type='CENTER_HOLE_PLATE',
 material_profile='ZNO_F1_NT', target_voltage=-7.0,
 target_voltage_factor=1.0, target_joule_factor=1.0, hole_radius=3.0e-6
/
&solver_control
 field_scales=1e-10,1e-10,1e-10,7.0,0.1,0.1,25.0,
 max_newton=40, residual_tolerance=1e-9, update_tolerance=1e-9,
 continuation_initial_step=0.25, continuation_minimum_step=0.015625,
 continuation_maximum_step=0.5, continuation_maximum_attempts=100,
 continuation_maximum_newton_per_attempt=30
/
